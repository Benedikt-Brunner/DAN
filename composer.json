{
    "name": "dan/harness",
    "description": "DAL ANalyzer - repeatable, isolated profiling of the SQL produced by Shopware's DAL.",
    "license": "MIT",
    "type": "project",
    "require": {
        "dan/lib": "^1.0",
        "php": ">=8.4",
        "ext-pdo_sqlite": "*",
        "markrogoyski/math-php": "^2.13",
        "symfony/console": "^7.0 || ^8.0",
        "symfony/filesystem": "^7.0 || ^8.0",
        "symfony/process": "^7.0 || ^8.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3",
        "giorgiosironi/eris": "^1.1",
        "infection/infection": "^0.35",
        "pestphp/pest": "^5.1",
        "phpat/phpat": "^0.12.4",
        "phpstan/phpstan": "^2",
        "phpstan/phpstan-deprecation-rules": "^2",
        "phpunit/phpunit": "^13.3",
        "shipmonk/dead-code-detector": "^1.3",
        "squizlabs/php_codesniffer": "^3"
    },
    "autoload": {
        "psr-4": {
            "Dan\\Harness\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Dan\\Harness\\Dev\\": "dev/",
            "Dan\\Harness\\Tests\\": "tests/",
            "Dan\\Probe\\": "bundle/src/"
        },
        "classmap": [
            "tests/PhpStan/Fixtures/"
        ]
    },
    "bin": [
        "bin/dan"
    ],
    "repositories": [
        {
            "type": "path",
            "url": "lib",
            "options": {
                "symlink": true
            }
        }
    ],
    "config": {
        "allow-plugins": {
            "infection/extension-installer": true,
            "pestphp/pest-plugin": true
        },
        "sort-packages": true
    },
    "scripts": {
        "check": [
            "@lint",
            "@phpstan",
            "@test"
        ],
        "lint": [
            "php-cs-fixer fix --dry-run --diff",
            "phpcs"
        ],
        "lint:fix": [
            "phpcbf --no-colors || true",
            "php-cs-fixer fix"
        ],
        "phpstan": "phpstan analyse",
        "test": "pest",
        "test:mutation": "infection --threads=max --show-mutations"
    }
}
