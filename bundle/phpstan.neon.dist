# Static analysis for the probe bundle, analyzed against the shopware/core
# dev dependency (run `composer install` in bundle/ first).
includes:
    - vendor/shipmonk/dead-code-detector/rules.neon
    - vendor/phpstan/phpstan-deprecation-rules/rules.neon
    - vendor/phpat/phpat/extension.neon

parameters:
    level: max
    treatPhpDocTypesAsCertain: false
    phpat:
        # Relations with PHP core and extension classes are never
        # architecture violations.
        ignore_built_in_classes: true
        show_rule_names: true
    paths:
        - src
        - tests
rules:
    # Autoloaded via the bundle's own autoload-dev mapping to ../dev/.
    - Dan\Harness\Dev\PhpStan\RequireNamedArgumentsRule

services:
    -
        class: Dan\Probe\Tests\Arch\DependencyDirectionRules
        tags:
            - phpat.test
