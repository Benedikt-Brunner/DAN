{
    "name": "dan/probe",
    "description": "In-app measurement agent for DAN: executes corpus scenarios against the DAL, records the produced SQL, and seeds deterministic datasets.",
    "license": "MIT",
    "type": "symfony-bundle",
    "require": {
        "dan/lib": "^1.0",
        "php": ">=8.2",
        "shopware/core": ">=6.5"
    },
    "require-dev": {
        "phpstan/phpstan": "^2",
        "phpunit/phpunit": "^11.0",
        "shipmonk/dead-code-detector": "^1.3",
        "shopware/core": "~6.6.0",
        "phpstan/phpstan-deprecation-rules": "^2"
    },
    "autoload": {
        "psr-4": {
            "Dan\\Probe\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Dan\\Harness\\Dev\\": "../dev/",
            "Dan\\Probe\\Tests\\": "tests/"
        }
    },
    "repositories": [
        {
            "type": "path",
            "url": "../lib",
            "options": {
                "symlink": true
            }
        }
    ],
    "config": {
        "allow-plugins": {
            "symfony/runtime": true
        }
    }
}
