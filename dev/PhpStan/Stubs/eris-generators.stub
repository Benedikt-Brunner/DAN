<?php

// PHPStan stub: Eris's generator factory functions carry no return types
// (several build their argument lists via func_get_args()), so every
// composition site would degrade to mixed at level max. This pins them to
// the Eris\Generator interface; element types are re-established at the
// call sites through DomainGenerators' as*() narrowers. The interface is
// re-declared here because stub files only see other stubs.

namespace Eris;

