# DAN static analysis - deliberately self-contained, no shared base config.
# The probe bundle has its own phpstan.neon.dist (it needs shopware/core
# to be analyzable): see bundle/phpstan.neon.dist.
includes:
    - vendor/shipmonk/dead-code-detector/rules.neon
    - vendor/phpstan/phpstan-deprecation-rules/rules.neon
    - vendor/phpat/phpat/extension.neon

parameters:
    level: max
    treatPhpDocTypesAsCertain: false
    phpat:
        # PHP core and extension classes are never architecture violations.
        ignore_built_in_classes: true
        show_rule_names: true
    scanDirectories:
        - vendor/squizlabs/php_codesniffer/src
        # Eris defines its generator functions as side effects of the class
        # files, invisible to autoload-based discovery.
        - vendor/giorgiosironi/eris/src
    stubFiles:
        - dev/PhpStan/Stubs/eris-generators.stub
    paths:
        - src
        - lib/src
        - tests
        - bin/dan
        - dev
    excludePaths:
        # Deliberately violates the named-arguments rule it tests.
        - tests/PhpStan/Fixtures
        # Consumed via stubFiles above, not as analyzable sources.
        - dev/PhpStan/Stubs

rules:
    - Dan\Harness\Dev\PhpStan\RequireNamedArgumentsRule

services:
    -
        class: Dan\Harness\Tests\Arch\DependencyDirectionRules
        tags:
            - phpat.test
